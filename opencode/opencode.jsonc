{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/.config/opencode/ia-hub.md"],
  "model": "openai/gpt-5.6-terra",
  "small_model": "google/gemini-3.1-flash-lite",
  "default_agent": "orchestrator",
  "enabled_providers": ["openai", "google", "opencode"],
  "subagent_depth": 1,
  "share": "disabled",
  "provider": {
    "openai": {
      "whitelist": ["gpt-5.6-luna", "gpt-5.6-sol", "gpt-5.6-terra"]
    },
    "google": {
      "whitelist": ["gemini-3.1-flash-lite", "gemini-3.6-flash"]
    },
    "opencode": {
      "whitelist": ["mimo-v2.5-free"]
    }
  },
  "permission": {
    "webfetch": "allow",
    "websearch": "allow"
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 12000
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 6,
    "preserve_recent_tokens": 12000,
    "reserved": 12000
  },
  "experimental": {
    "batch_tool": true
  }
}
