@echo off
setlocal
title Instalador de Menu de Contexto - Agentes de IA
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "& { [IO.File]::ReadAllLines($args[0]) | Select-Object -Skip 7 | Out-String | Invoke-Expression }" "%~f0"
pause
exit /b %errorlevel%

# --- POWERSHELL EMBEDDED SCRIPT ---

$ErrorActionPreference = 'Stop'
[Console]::OutputEncoding = [System.Text.Encoding]::UTF8

Write-Host "========================================================" -ForegroundColor Cyan
Write-Host "   Instalador de Menu de Contexto: Agentes de IA (CLI)  " -ForegroundColor Cyan
Write-Host "========================================================" -ForegroundColor Cyan
Write-Host ""

$BaseDir       = Join-Path $env:LOCALAPPDATA 'AgentesIA'
$LaunchersDir  = Join-Path $BaseDir 'launchers'
$IconsDir      = Join-Path $BaseDir 'icons'
New-Item -ItemType Directory -Force $LaunchersDir | Out-Null
New-Item -ItemType Directory -Force $IconsDir | Out-Null

# 0. Garante o icone oficial laranja do Claude
$claudeIcoPath = Join-Path $IconsDir 'ClaudeCLI.ico'
$claudeB64 = ''
try {
    [IO.File]::WriteAllBytes($claudeIcoPath, [Convert]::FromBase64String($claudeB64))
} catch {}

# 1. Definicao das ferramentas e regras
$Tools = @(
    @{
        Key          = 'AntigravityCLI'
        Label        = 'Abrir com Antigravity CLI'
        Title        = 'Antigravity CLI'
        Commands     = @('agy')
        Paths        = @(
            "$env:LOCALAPPDATA\agy\bin\agy.exe",
            "$env:LOCALAPPDATA\Programs\Antigravity CLI\agy.exe"
        )
        LauncherName = 'launch-antigravity.cmd'
        IconFiles    = @(
            "$env:LOCALAPPDATA\Programs\Antigravity\Antigravity.exe",
            "$env:ProgramFiles\Antigravity\Antigravity.exe",
            "$env:LOCALAPPDATA\agy\antigravity.ico"
        )
        Appx         = @('*Antigravity*')
        GetScript    = {
            param($exe)
            $code = "@echo off`r`nsetlocal`r`n`r`nnet session >nul 2>&1`r`nif %errorlevel% neq 0 (`r`n    powershell -NoProfile -WindowStyle Hidden -Command ""Start-Process cmd.exe -ArgumentList '/k title Antigravity CLI [Admin] & call """"%~f0"""" """"%~1""""' -Verb RunAs""`r`n    exit /b`r`n)`r`n`r`nif not ""%~1""=="""" (`r`n    if exist ""%~1\"" (`r`n        cd /d ""%~1""`r`n    ) else if exist ""%~1"" (`r`n        cd /d ""%~dp1""`r`n    )`r`n)`r`n`r`ntitle Antigravity CLI [Admin]`r`nset ""AGY_CMD=$exe""`r`ncall ""%AGY_CMD%"" --dangerously-skip-permissions --model gemini-3.8-flash-medium`r`n"
            return $code
        }
    },
    @{
        Key          = 'ClaudeCLI'
        Label        = 'Abrir com Claude CLI'
        Title        = 'Claude CLI'
        Commands     = @('claude')
        Paths        = @(
            "$env:USERPROFILE\.local\bin\claude.exe",
            "$env:LOCALAPPDATA\Microsoft\WinGet\Links\claude.exe",
            "$env:APPDATA\npm\node_modules\@anthropic-ai\claude-code\bin\claude.exe",
            "$env:APPDATA\npm\claude.cmd",
            "$env:LOCALAPPDATA\Programs\claude\claude.exe",
            "$env:LOCALAPPDATA\AnthropicClaude\app\claude.exe"
        )
        LauncherName = 'launch-claude.cmd'
        IconFiles    = @(
            $claudeIcoPath,
            "$env:LOCALAPPDATA\AnthropicClaude\app.ico"
        )
        Appx         = @('*Claude*')
        GetScript    = {
            param($exe)
            $code = "@echo off`r`nsetlocal`r`n`r`nnet session >nul 2>&1`r`nif %errorlevel% neq 0 (`r`n    powershell -NoProfile -WindowStyle Hidden -Command ""Start-Process cmd.exe -ArgumentList '/k title Claude CLI [Admin] & call """"%~f0"""" """"%~1""""' -Verb RunAs""`r`n    exit /b`r`n)`r`n`r`nif not ""%~1""=="""" (`r`n    if exist ""%~1\"" (`r`n        cd /d ""%~1""`r`n    ) else if exist ""%~1"" (`r`n        cd /d ""%~dp1""`r`n    )`r`n)`r`n`r`nset ""CLAUDE_CODE_SUBAGENT_MODEL=haiku""`r`ntitle Claude CLI [Admin]`r`nset ""CLAUDE_CMD=$exe""`r`ncall ""%CLAUDE_CMD%"" --dangerously-skip-permissions --model sonnet --advisor opus --chrome`r`n"
            return $code
        }
    },
    @{
        Key          = 'CodexCLI'
        Label        = 'Abrir com Codex CLI'
        Title        = 'Codex CLI'
        Commands     = @('codex')
        Paths        = @(
            "$env:LOCALAPPDATA\Microsoft\WinGet\Links\codex.exe",
            "$env:LOCALAPPDATA\Programs\OpenAI\Codex\bin\codex.exe",
            "$env:USERPROFILE\.codex\bin\codex.exe",
            "$env:APPDATA\npm\codex.cmd"
        )
        LauncherName = 'launch-codex.cmd'
        IconFiles    = @(
            "$env:LOCALAPPDATA\IA-Hub\icons\CodexCLI.ico",
            "$env:USERPROFILE\.codex\codex.ico"
        )
        Appx         = @('*Codex*', '*ChatGPT*')
        GetScript    = {
            param($exe)
            $code = "@echo off`r`nsetlocal`r`n`r`nnet session >nul 2>&1`r`nif %errorlevel% neq 0 (`r`n    powershell -NoProfile -WindowStyle Hidden -Command ""Start-Process cmd.exe -ArgumentList '/k title Codex CLI [Admin] & call """"%~f0"""" """"%~1""""' -Verb RunAs""`r`n    exit /b`r`n)`r`n`r`nif not ""%~1""=="""" (`r`n    if exist ""%~1\"" (`r`n        cd /d ""%~1""`r`n    ) else if exist ""%~1"" (`r`n        cd /d ""%~dp1""`r`n    )`r`n)`r`n`r`ntitle Codex CLI [Admin]`r`nset ""CODEX_CMD=$exe""`r`ncall ""%CODEX_CMD%"" --dangerously-bypass-approvals-and-sandbox --dangerously-bypass-hook-trust -c model=\""gpt-6.2-sol\"" -c model_reasoning_effort=\""medium\"" --search`r`n"
            return $code
        }
    }
)

$Targets = @(
    @{ ShellPath = 'Software\Classes\Directory\shell';            Arg = '%V'    },
    @{ ShellPath = 'Software\Classes\Directory\Background\shell'; Arg = '%V'    },
    @{ ShellPath = 'Software\Classes\Drive\shell';                Arg = '%V'    },
    @{ ShellPath = 'Software\Classes\*\shell';                    Arg = '%1\..' }
)

# Funcao de busca de executavel
function Find-Cli($Tool) {
    foreach ($cmd in $Tool.Commands) {
        $hit = Get-Command $cmd -CommandType Application -All -ErrorAction SilentlyContinue |
            Where-Object { $_.Extension -in '.exe', '.cmd', '.bat' } |
            Sort-Object { if ($_.Extension -eq '.exe') { 0 } else { 1 } } |
            Select-Object -First 1
        if ($hit) { return $hit.Source }
    }
    foreach ($p in $Tool.Paths) {
        if (Test-Path -LiteralPath $p) { return (Resolve-Path -LiteralPath $p).Path }
    }
    return $null
}

# Funcao de deteccao de icone
function Resolve-Icon($Tool, [string]$Exe) {
    foreach ($f in $Tool.IconFiles) {
        if (Test-Path -LiteralPath $f) {
            if ($f -like '*.exe') { return "$f,0" } else { return $f }
        }
    }
    foreach ($pattern in $Tool.Appx) {
        $pkgs = try { Get-AppxPackage -Name $pattern -ErrorAction Stop } catch { @() }
        foreach ($pkg in $pkgs) {
            $loc = $pkg.InstallLocation
            if (-not $loc -or -not (Test-Path -LiteralPath $loc)) { continue }
            $ico = Get-ChildItem -LiteralPath $loc -Filter *.ico -Recurse -Depth 4 -File -ErrorAction SilentlyContinue |
                Sort-Object Length -Descending | Select-Object -First 1
            if ($ico) { return $ico.FullName }
        }
    }
    if ($Exe -like '*.exe') { return "$Exe,0" }
    return "$env:SystemRoot\System32\cmd.exe,0"
}

# 1. Limpeza previa de variacoes
Write-Host '[1/4] Verificando e removendo variacoes antigas/duplicatas...' -ForegroundColor Yellow

$keyPatterns = @('^Claude.*', '^Antigravity.*', '^Agy.*', '^Codex.*', '^OpenAI.*Codex.*', '^OpenCode$')
$labelPatterns = @('Claude', 'Antigravity', 'Codex')

$cleanedCount = 0
foreach ($t in $Targets) {
    try {
        $reg = [Microsoft.Win32.Registry]::CurrentUser.OpenSubKey($t.ShellPath, $true)
        if (-not $reg) { continue }
        $subKeys = @($reg.GetSubKeyNames())
        foreach ($k in $subKeys) {
            $shouldDelete = $false
            foreach ($kp in $keyPatterns) {
                if ($k -match $kp) { $shouldDelete = $true; break }
            }
            if (-not $shouldDelete) {
                $sk = $reg.OpenSubKey($k)
                if ($sk) {
                    $lbl = [string]$sk.GetValue('')
                    foreach ($lp in $labelPatterns) {
                        if ($lbl -like "*$lp*") { $shouldDelete = $true; break }
                    }
                    $sk.Close()
                }
            }
            if ($shouldDelete) {
                Write-Host "  [-] Removida entrada anterior: $($t.ShellPath)\$k" -ForegroundColor DarkGray
                $reg.DeleteSubKeyTree($k, $false)
                $cleanedCount++
            }
        }
        $reg.Close()
    } catch {}
}
if ($cleanedCount -eq 0) {
    Write-Host '  ✓ Nenhuma duplicata encontrada.' -ForegroundColor Green
} else {
    Write-Host "  ✓ $cleanedCount variacoes antigas removidas com sucesso." -ForegroundColor Green
}
Write-Host ''

# 2. Identifica os CLIs disponiveis nesta maquina
Write-Host '[2/4] Identificando CLIs instalados neste computador...' -ForegroundColor Yellow
$found = @()
foreach ($tool in $Tools) {
    $exe = Find-Cli $tool
    if ($exe) {
        $icon = Resolve-Icon $tool $exe
        $launcherFile = Join-Path $LaunchersDir $tool.LauncherName
        $launcherContent = & $tool.GetScript $exe
        [IO.File]::WriteAllText($launcherFile, $launcherContent, [System.Text.Encoding]::ASCII)
        
        Write-Host "  [+] $($tool.Title) ENCONTRADO!" -ForegroundColor Green
        Write-Host "      Executavel: $exe" -ForegroundColor Gray
        Write-Host "      Launcher:   $launcherFile" -ForegroundColor Gray
        Write-Host "      Icone:      $icon" -ForegroundColor Gray
        $found += @{
            Tool     = $tool
            Exe      = $exe
            Launcher = $launcherFile
            Icon     = $icon
        }
    } else {
        Write-Host "  [-] $($tool.Title) nao detectado (ignorado)." -ForegroundColor DarkGray
    }
}
Write-Host ''

if ($found.Count -eq 0) {
    Write-Host 'Nenhum dos 3 CLIs (Antigravity, Claude, Codex) foi encontrado nesta maquina.' -ForegroundColor Red
    Write-Host 'Instale os CLIs desejados e execute este script novamente.' -ForegroundColor Yellow
    return
}

# 3. Registra os menus de contexto no Windows Explorer
Write-Host '[3/4] Registrando itens no menu de contexto (com escudo Admin)...' -ForegroundColor Yellow
foreach ($f in $found) {
    $tool = $f.Tool
    $launcher = $f.Launcher
    $icon = $f.Icon
    
    foreach ($t in $Targets) {
        $keyPath = "$($t.ShellPath)\$($tool.Key)"
        $command = "cmd.exe /c `"`"$launcher`" `"$($t.Arg)`"`""
        
        $k = [Microsoft.Win32.Registry]::CurrentUser.CreateSubKey($keyPath)
        $k.SetValue('', $tool.Label)
        $k.SetValue('Icon', $icon)
        $k.SetValue('HasLUAShield', '')
        $k.Close()
        
        $c = [Microsoft.Win32.Registry]::CurrentUser.CreateSubKey("$keyPath\command")
        $c.SetValue('', $command)
        $c.Close()
    }
    Write-Host "  ✓ $($tool.Label) registrado com sucesso!" -ForegroundColor Green
}
Write-Host ''

# 4. Atualiza caches do Windows Explorer
Write-Host '[4/4] Atualizando caches do Windows Explorer...' -ForegroundColor Yellow
Add-Type -Namespace Win32 -Name Shell -MemberDefinition @'
[DllImport("shell32.dll")]
public static extern void SHChangeNotify(int wEventId, uint uFlags, System.IntPtr dwItem1, System.IntPtr dwItem2);
'@ -ErrorAction SilentlyContinue
[Win32.Shell]::SHChangeNotify(0x08000000, 0, [IntPtr]::Zero, [IntPtr]::Zero)
Start-Process -FilePath "$env:SystemRoot\System32\ie4uinit.exe" -ArgumentList '-show' -WindowStyle Hidden -ErrorAction SilentlyContinue

Write-Host ''
Write-Host '========================================================' -ForegroundColor Green
Write-Host '  Concluido com sucesso! Menus prontos para uso.        ' -ForegroundColor Green
Write-Host '========================================================' -ForegroundColor Green
Write-Host 'Pode clicar com o botao direito em qualquer pasta para testar.' -ForegroundColor Cyan
